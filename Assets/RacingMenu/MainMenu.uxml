<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/RacingMenu/MainMenu.uss" />

    <!-- Root is TRANSPARENT — it overlays your in-game 3D scene. -->
    <ui:VisualElement name="root" class="root">

        <!-- =================== LOGO =================== -->
        <ui:VisualElement name="logo" class="logo" picking-mode="Ignore">
            <ui:VisualElement class="logo__top">
                <ui:Label text="DRIVING" class="logo__word" />
                <ui:Label text="VR" class="logo__vr" />
            </ui:VisualElement>
            <ui:Label text="SIMULATOR" class="logo__sub" />
        </ui:VisualElement>

        <!-- =================== MENU =================== -->
        <ui:VisualElement name="menu" class="menu">

            <!-- START (selected) — solid white + helmet badge -->
            <ui:Button name="start-button" class="btn btn--start">
                <ui:VisualElement class="btn__icon icon--flag" picking-mode="Ignore" />
                <ui:VisualElement class="btn__text" picking-mode="Ignore">
                    <ui:Label text="START" class="btn__label" />
                </ui:VisualElement>
                <ui:VisualElement class="badge" picking-mode="Ignore">
                    <ui:VisualElement class="badge__icon icon--helmet" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:Button>

            <!-- SETTINGS -->
            <ui:Button name="settings-button" class="btn">
                <ui:VisualElement class="btn__icon icon--gear" picking-mode="Ignore" />
                <ui:VisualElement class="btn__text" picking-mode="Ignore">
                    <ui:Label text="SETTINGS" class="btn__label" />
                </ui:VisualElement>
            </ui:Button>

            <!-- LOG IN / LOG OUT -->
            <ui:Button name="login-button" class="btn">
                <ui:VisualElement class="btn__icon icon--user" picking-mode="Ignore" />
                <ui:VisualElement class="btn__text" picking-mode="Ignore">
                    <ui:Label text="PROFILE" class="btn__label" />
                    <ui:Label text="ACCOUNT &amp; ATTEMPTS" class="btn__sub" />
                </ui:VisualElement>
            </ui:Button>

            <!-- QUIT — solid red -->
            <ui:Button name="quit-button" class="btn btn--quit">
                <ui:VisualElement class="btn__icon icon--power" picking-mode="Ignore" />
                <ui:VisualElement class="btn__text" picking-mode="Ignore">
                    <ui:Label text="QUIT" class="btn__label" />
                </ui:VisualElement>
            </ui:Button>

        </ui:VisualElement>

        <!-- =================== BOTTOM HINT + SPARKLE =================== -->
        <ui:VisualElement name="nav-hint" class="nav-hint" picking-mode="Ignore">
            <ui:VisualElement class="nav-hint__line" />
            <ui:VisualElement class="nav-hint__icon icon--swap" />
            <ui:VisualElement class="nav-hint__line" />
        </ui:VisualElement>

        <ui:VisualElement name="sparkle" class="sparkle icon--sparkle" picking-mode="Ignore" />

        <!-- =================== PROFILE OVERLAY =================== -->
        <ui:VisualElement name="profile-overlay" class="overlay hidden">
            <ui:VisualElement class="profile-card">
                <ui:Label name="profile-name" text="PROFILE" class="profile-title" picking-mode="Ignore" />
                <ui:Label name="profile-summary" text="" class="profile-summary" picking-mode="Ignore" />
                <ui:ScrollView name="attempts-list" class="attempts-list" />
                <ui:Button name="profile-close" class="btn settings-close">
                    <ui:VisualElement class="btn__text" picking-mode="Ignore">
                        <ui:Label text="CLOSE" class="btn__label" />
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button name="profile-logout" class="profile-logout-btn icon--logout" tooltip="Log out" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- =================== LOGIN OVERLAY =================== -->
        <ui:VisualElement name="login-overlay" class="overlay hidden">
            <ui:VisualElement class="settings-card">
                <ui:Label name="login-title" text="SIGN IN" class="settings-title" />

                <ui:VisualElement name="login-fullname-row" class="srow">
                    <ui:Label text="Full name" class="srow__label" />
                    <ui:TextField name="login-fullname" class="srow__control" />
                </ui:VisualElement>

                <ui:VisualElement class="srow">
                    <ui:Label text="Phone" class="srow__label" />
                    <ui:TextField name="login-phone" class="srow__control" />
                </ui:VisualElement>

                <ui:VisualElement class="srow">
                    <ui:Label text="Password" class="srow__label" />
                    <ui:TextField name="login-password" password="true" class="srow__control" />
                </ui:VisualElement>

                <ui:Label name="login-status" text="" class="login-status" />

                <ui:VisualElement class="profile-actions">
                    <ui:Button name="login-submit" class="btn btn--start profile-action">
                        <ui:VisualElement class="btn__text" picking-mode="Ignore">
                            <ui:Label name="login-submit-label" text="SIGN IN" class="btn__label" />
                        </ui:VisualElement>
                    </ui:Button>
                    <ui:Button name="login-close" class="btn profile-action">
                        <ui:VisualElement class="btn__text" picking-mode="Ignore">
                            <ui:Label text="CANCEL" class="btn__label" />
                        </ui:VisualElement>
                    </ui:Button>
                </ui:VisualElement>

                <ui:Button name="login-switch" class="login-switch-btn">
                    <ui:Label name="login-switch-label" text="No account? Sign up" class="login-switch-label" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- =================== SETTINGS OVERLAY =================== -->
        <ui:VisualElement name="settings-overlay" class="overlay hidden">
            <ui:VisualElement class="settings-card">
                <ui:Label text="SETTINGS" class="settings-title" />

                <ui:VisualElement class="srow">
                    <ui:Label text="Volume" class="srow__label" />
                    <ui:Slider name="volume" low-value="0" high-value="1" class="srow__control" />
                </ui:VisualElement>

                <ui:VisualElement class="srow">
                    <ui:Label text="Quality" class="srow__label" />
                    <ui:DropdownField name="quality" class="srow__control" />
                </ui:VisualElement>

                <ui:VisualElement class="srow">
                    <ui:Label text="FPS Limit" class="srow__label" />
                    <ui:DropdownField name="fps" class="srow__control" />
                </ui:VisualElement>

                <ui:VisualElement class="srow">
                    <ui:Label text="V-Sync" class="srow__label" />
                    <ui:Toggle name="vsync" class="srow__control" />
                </ui:VisualElement>

                <ui:VisualElement class="srow">
                    <ui:Label text="Input" class="srow__label" />
                    <ui:DropdownField name="input-type" class="srow__control" />
                </ui:VisualElement>

                <ui:VisualElement class="srow">
                    <ui:Label text="Navigation Help" class="srow__label" />
                    <ui:Toggle name="nav-help" class="srow__control" />
                </ui:VisualElement>

                <ui:Button name="settings-close" class="btn btn--quit settings-close">
                    <ui:VisualElement class="btn__text" picking-mode="Ignore">
                        <ui:Label text="CLOSE" class="btn__label" />
                    </ui:VisualElement>
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
